# ============================================================
# ARCANA Monorepo — .gitignore
# ============================================================
# Covers: be-core3d (Node/Express), fe (Vite/React/TS), inklusi (Python ML)
# ============================================================


# ─────────────────────────────────────────────
# 🔐 ENVIRONMENT & SECRETS — NEVER COMMIT THESE
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─────────────────────────────────────────────
# 📦 Node / NPM / PNPM (be-core3d & fe)
# ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# ─────────────────────────────────────────────
# 🏗️  Build Outputs (fe)
# ─────────────────────────────────────────────
fe/dist/
fe/.vite/
fe/build/
fe/.next/
fe/out/

# ─────────────────────────────────────────────
# 🐍 Python (inklusi ML pipeline)
# ─────────────────────────────────────────────

## Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

## Virtual environments
.venv/
venv/
env/
ENV/
.env/
.Python

## Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
*.whl

## Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

## ML model artifacts (large binary files — use DVC or Git LFS if needed)
inklusi/models/finetuned/
inklusi/checkpoints/
*.pkl
*.joblib
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.bin
*.safetensors

## Processed / generated data (re-derivable from source)
inklusi/data/processed/
inklusi/data/index/

## Python testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml

## Linting / type-checking caches
.mypy_cache/
.ruff_cache/
.pytype/

## IPython
profile_default/
ipython_config.py

